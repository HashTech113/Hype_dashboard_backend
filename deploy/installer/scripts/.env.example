# =====================================================================
# Backend configuration — PRODUCTION
# The installer drops a placeholder JWT_SECRET_KEY then runs a Python
# one-liner to replace it with secrets.token_urlsafe(48) on first boot.
# =====================================================================

# Postgres connection — assumes default install, password "postgres".
# Change if your PG was set up differently.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_attendance

APP_NAME=AI Camera Surveillance
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false

# Generated by the installer post-install step. DO NOT COMMIT.
JWT_SECRET_KEY=__GENERATED_BY_INSTALLER__
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe@123

# Face recognition
FACE_MODEL_NAME=buffalo_l
FACE_MODEL_ROOT=./storage/models
FACE_PROVIDER=CPUExecutionProvider
FACE_DET_SIZE=320
FACE_MATCH_THRESHOLD=0.45
FACE_MIN_QUALITY=0.50
FACE_TRAIN_MIN_IMAGES=5
FACE_TRAIN_MAX_IMAGES=20

# Camera pipeline — realtime defaults
CAMERA_FPS=15
CAMERA_COOLDOWN_SECONDS=5
CAMERA_HEALTH_INTERVAL_SECONDS=10
CAMERA_HEARTBEAT_TIMEOUT_SECONDS=30
RTSP_CONNECT_TIMEOUT_MS=5000
RTSP_READ_TIMEOUT_MS=5000
RTSP_RECONNECT_MAX_SECONDS=30

STORAGE_ROOT=./storage
TRAINING_DIR=./storage/training_images
SNAPSHOT_DIR=./storage/snapshots
UNKNOWNS_DIR=./storage/unknowns

TIMEZONE=Asia/Kolkata

# CORS — frontend is served on the same host so localhost variants are fine.
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_MAX_BYTES=104857600
LOG_BACKUP_COUNT=5
